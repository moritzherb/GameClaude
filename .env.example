# Copy to .env.local (or set in GitHub / EAS, see docs/STORE.md).

# Supabase (backup codes, shared Party boards): Project Settings → API.
# The publishable/anon key is meant to be public; the database rules (supabase/migrations) protect the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Your own MQTT servers for rooms instead of the public ones (comma-separated, optional).
# VITE_RELAY_SERVERS=wss://mqtt.example.com:8884/mqtt
