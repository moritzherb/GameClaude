{
  "name": "prost-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-tracking-transparency": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "web": "cd .. && npm run build:app",
    "start": "npm run web && expo start --dev-client",
    "android": "npm run web && expo run:android",
    "ios": "npm run web && expo run:ios",
    "typecheck": "tsc --noEmit",
    "check": "npm run web && tsc --noEmit && expo export --platform ios --platform android --output-dir dist",
    "eas-build-post-install": "cd .. && npm ci --no-audit --no-fund && npm run build:app"
  },
  "private": true
}
